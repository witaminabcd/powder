                </div>
                <div class="header__block-img">
                    <img src="../img/timer.svg" alt="">
                </div>

            </div>
            <div class="header__block">
                <div class="header__block-text">
                    <div class="header__block-title">Размер печи:</div>
                    <div class="header__block-subtitle">длина 7 м., ширина 2,4 м., высота 2,4 м.</div>
                </div>
                <div class="header__block-img">
                    <img src="../img/timer.svg" alt="">
