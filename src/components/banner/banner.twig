<div class="banner">
    {% include './header.twig' %}
    <div class="banner-wrap">


        <h1>Порошковая покраска и пескоструйная обработка </h1>
        <div class="banner-btn">
            <div class="btn-light-green">
                <span>Оставить заявку </span>
            </div>
        </div>
        <div class="header__blocks">
            <div class="header__block">
                <div class="header__block-text">
                    <div class="header__block-title">От 24 часов</div>
                    <div class="header__block-subtitle">выполнение заказа*</div>
                </div>
                <div class="header__block-img">
                    <img src="../img/timer.svg" alt="">
                </div>

            </div>
            <div class="header__block">
                <div class="header__block-text">
                    <div class="header__block-title">Бесплатная доставка</div>
