<div class="tehnolog">
    <div class="tehnolog-wrap">
        <div class="tehnolog-form">

            <div class="tehnolog-img">
                <img src="../img/form22.png" alt="">
            </div>
            <form action="">
                <div class="tehnolog-form-title">
                    Получите бесплатную консультацию технолога
                </div>
                <div class="tehnolog-form-subtitle">
                    Заполните форму и мы свяжемся с Вами для согласования сроков и стоимости
                </div>
                <div class="tehnolog-form-name">
                    <input type="text" name="name" placeholder="Имя">
                </div>
                <div class="tehnolog-form-phone">
                    <input type="tel" name="phone" placeholder="+7 (999) 999-99-99">
                </div>
                <div class="tehnolog-form-submit">
                    <div class="banner-btn">
                        <div class="btn-light-green"><span>Оставить заявку</span></div>
                    </div>

                </div>
            </form>
        </div>
    </div>
</div>