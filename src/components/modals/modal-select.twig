<div class="modal-select" id="modalOverlay2">
    <div class="modal ">
        <button class="modal-close" id="modalClose2">&times;</button>
        <h2 class="modal-title">Оставить заявку</h2>

        <form class="modal-form2">
            <div class="form-group-title">
                Выбор услуг
            </div>
            <div class="form-group form-group-main">

                <div class="form-group-wrap">
                    <input type="checkbox" name="select" checked>
                    <label for="select">Порошковая покраска </label>

                </div>
                <div class="form-group-wrap">
                    <input type="checkbox" name="select2" >
                    <label for="select2">Пескоструйная обработка </label>

                </div>


            </div>
            <div class="form-group">
                <input type="text" id="name" placeholder="Ваше имя">
            </div>

            <div class="form-group">
                <input type="tel" id="phone" placeholder="+7 (999) 999-99-99">
            </div>

            <button type="submit" class="submit-btn ">Оставить заявку</button>

            <div class="form-notice">
                <div class="form-notice-agree">
                    <input type="checkbox" checked>
                </div>
                <div class="form-notice-text">
                    Нажимая на кнопку, Вы даете согласие на обработку персональных данных
                    и соглашаетесь с <a href="#">политикой конфиденциальности</a>.
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Кнопка для открытия модального окна (для демонстрации) -->
<button id="openModal2" class="demo-btn">Открыть форму</button>